{
  "expo": {
    "name": "Colok.in",
    "slug": "colokin",
    "version": "0.1.0",
    "orientation": "portrait",
    "platforms": ["ios", "android"],
    "scheme": "colokin",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "space.albern.colokin"
    },
    "android": {
      "package": "space.albern.colokin",
      "adaptiveIcon": {
        "backgroundColor": "#0B5FFF"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#0B5FFF"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
