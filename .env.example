NODE_ENV=development
API_PORT=4000

# Local host development:
DATABASE_URL=postgresql://colokin:colokin@127.0.0.1:15432/colokin?schema=public
# Docker Compose API container:
# DATABASE_URL=postgresql://colokin:colokin@postgres:5432/colokin?schema=public

JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me

MQTT_URL=mqtt://127.0.0.1:1883
# Docker Compose API container:
# MQTT_URL=mqtt://mosquitto:1883
IOT_MODE=mock

FCM_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

EXPO_PUBLIC_API_URL=http://127.0.0.1:4000/v1

# Server/tunnel deployment:
# PUBLIC_API_URL=https://api.colokin.albern.space/v1
# CLOUDFLARED_TUNNEL_TOKEN=
